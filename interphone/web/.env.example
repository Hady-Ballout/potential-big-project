# Copy to web/.env.local (git-ignored). Restart `npm run dev` after changing.
# Local Supabase (`npx supabase start`). For a phone on the same Wi-Fi use http://<laptop LAN IP>:54321
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Printed by `npx supabase status` (anon key)
VITE_SUPABASE_ANON_KEY=
# Optional. Same value as VAPID_PUBLIC_KEY in supabase/.env. Leave empty to hide the notifications button.
VITE_VAPID_PUBLIC_KEY=
