; Copy to secrets.ini (git-ignored) and fill in. Values are C string literals, keep the \" quotes.
[secrets]
build_flags =
    -DWIFI_SSID=\"YourHomeWiFi\"
    -DWIFI_PASS=\"YourPassword\"
    -DDEVICE_TOKEN=\"paste-the-device-token-from-supabase-seed\"
    -DSUPABASE_FUNCTIONS_URL=\"https://YOUR-PROJECT-REF.supabase.co/functions/v1\"
