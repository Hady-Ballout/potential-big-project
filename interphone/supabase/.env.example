# Copy to supabase/.env for `supabase functions serve --env-file supabase/.env`,
# and set the same in the cloud with `supabase secrets set --env-file supabase/.env`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Managed TURN. Create and rotate this credential in Metered before it expires.
METERED_DOMAIN=your-app.metered.live
METERED_TURN_API_KEY=
